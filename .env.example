# -----------------------------------------------------------------------------
# RPI Student Government website environment
# -----------------------------------------------------------------------------
# Copy this file to .env and replace every placeholder before deploying:
#
#   cp .env.example .env
#
# The real .env is intentionally ignored by Git. Restrict its permissions on
# the deployment host (for example: chmod 600 .env) and do not commit secrets.

# Django settings module used inside the Wagtail container.
DJANGO_SETTINGS_MODULE=stugov.settings.production

# Container path for the persistent SQLite database and uploaded media.
# This must correspond to the /app/data volume mount in docker-compose.yml.
DATA_DIR=/app/data/

# Generate a long, unique production value. Never reuse a development secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated hostnames accepted by Django. Do not include schemes.
DJANGO_ALLOWED_HOSTS=sg.rpi.edu

# Comma-separated HTTPS origins allowed for CSRF-protected requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://sg.rpi.edu

# Absolute public site URL without /admin or a trailing slash.
WAGTAILADMIN_BASE_URL=https://sg.rpi.edu

# Host path mounted into /app/data by Docker Compose. This value is also read
# by Compose itself when resolving the volume declaration.
HOST_DATA_DIR=/var/lib/stugov-site

# Enable only after confirming the upstream proxy sends
# X-Forwarded-Proto: https. Use 0 while initially validating the proxy chain.
DJANGO_SECURE_SSL_REDIRECT=0

# Start at 0. After HTTPS redirects are confirmed, use 31536000 for one year.
DJANGO_HSTS_SECONDS=0

# -----------------------------------------------------------------------------
# Outbound email
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=student-government@example.edu

# -----------------------------------------------------------------------------
# CMS OpenID Connect SSO
# -----------------------------------------------------------------------------
# Set to 1 only after the CMS client, callback URL, logout URL, and role claims
# have been configured and tested. Set to 0 to retain local Wagtail login.
OIDC_ENABLED=0

# HTTPS issuer URL or the full .well-known/openid-configuration URL.
OIDC_SERVER_URL=https://sso.example.edu

# Client credentials issued to the CMS relying party.
OIDC_CLIENT_ID=replace-with-cms-client-id
OIDC_CLIENT_SECRET=replace-with-cms-client-secret

# CMS currently publishes all required claims under the openid scope.
OIDC_SCOPES=openid

# CMS publishes its list-valued authorization claim as groups.
OIDC_ROLE_CLAIM_PATH=groups

# Claim-to-group mappings are stored in the database and managed from
# Wagtail Admin > Snippets > OIDC group mappings. The initial migration seeds
# the CMS member, officer, and Web Technologies Committee President mappings.
